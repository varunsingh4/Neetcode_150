class Solution {
public:
    int solve(vector<int>& nums,int index,int max_sum,vector<int>& dp){
        if(index == 0)
        {
            return nums[0];
        }
        if(dp[index]!=-1)
        {
            return dp[index];
        }
        int prev=solve(nums,index-1,max_sum,dp);
        return dp[index]= max(nums[index],nums[index]+prev);            
    }
    int maxSubArray(vector<int>& nums) {
        int max_sum=INT_MIN;
        vector<int>dp(nums.size()+1,-1);
        int a =nums[0];
        for(int i=0;i<nums.size();i++)
        {
            a=max(a,solve(nums,i,max_sum,dp));
        }
        return a;
        
    }
};
